# Copy this file to `.env` before running Docker Compose.
# Run the stack with:
#   docker compose up --build
#   docker compose --profile async up --build
# Compose uses this file for interpolation, and compose.yaml forwards the same
# values into the container environment.
# Before this task there was no Compose file, no db service, and no
# cross-platform host mount configuration for the image library.

DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

POSTGRES_DB=fujifilm_recipes
POSTGRES_USER=fujifilm_recipes
POSTGRES_PASSWORD=fujifilm_recipes
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Windows: IMAGE_LIBRARY_SOURCE=C:/Users/arthur/Pictures/Fujifilm
# macOS: IMAGE_LIBRARY_SOURCE=/Users/arthur/Pictures/Fujifilm
# Linux: IMAGE_LIBRARY_SOURCE=/home/arthur/Pictures/Fujifilm
IMAGE_LIBRARY_SOURCE=/absolute/path/to/your/fujifilm/images
IMAGE_LIBRARY_ROOT=/data/images
THUMBNAIL_CACHE_DIR=/data/thumbnail-cache
LOG_DIR=/data/logs

RUN_MIGRATIONS=1

# Used by the optional async profile.
CELERY_BROKER_URL=amqp://fujifilm_recipes:fujifilm_recipes@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://
PROCESS_IMAGE_QUEUE=celery

RABBITMQ_DEFAULT_USER=fujifilm_recipes
RABBITMQ_DEFAULT_PASS=fujifilm_recipes
RABBITMQ_DEFAULT_VHOST=/
